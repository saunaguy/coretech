services:
  db:
    image: postgres:16-alpine
    container_name: coretech-db
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-coretech}
      POSTGRES_USER: ${POSTGRES_USER:-coretech}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-coretech}
    volumes:
      - pgdata:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    build:
      context: .
      dockerfile: backend/Dockerfile.backend
    container_name: coretech-backend
    environment:
      SECRET_KEY: my-fixed-secret-key-for-dev
      INACTIVITY_EXPIRE_SECONDS: ${INACTIVITY_EXPIRE_SECONDS:-1800}
      COOKIE_MAX_AGE_SECONDS: ${COOKIE_MAX_AGE_SECONDS:-86400}
      COOKIE_SECURE: ${COOKIE_SECURE:-false}
      COOKIE_SAMESITE: ${COOKIE_SAMESITE:-lax}
      COOKIE_NAME: ${COOKIE_NAME:-access_token}
      DATABASE_URL: ${DATABASE_URL:-sqlite:///./coretech.db}
      # 프로덕션에서 브라우저가 백엔드를 직접 두드린다면 아래에 HTTPS 도메인도 추가해줘.
      # CORS_ORIGINS: "https://coretechnet.tplinkdns.com,https://coretechnet.tplinkdns.com:3000"
      CORS_ORIGINS: ${CORS_ORIGINS:-http://localhost:3000,http://127.0.0.1:3000}
    ports:
      - "8000:8000"
    depends_on:
      db:
        condition: service_healthy

  frontend:
    build:
      context: .
      dockerfile: frontend/Dockerfile.frontend
      args:
        NEXT_PUBLIC_API_BASE_URL: ${API_BASE_URL:-http://localhost:8000}
        INACTIVITY_EXPIRE_SECONDS: ${INACTIVITY_EXPIRE_SECONDS:-60}
    container_name: coretech-frontend
    environment:
      NODE_ENV: production
      NEXT_PUBLIC_API_BASE_URL: http://backend:8000
      INTERNAL_API_BASE_URL: http://backend:8000
    expose:
      - "3000"       # 외부 포트 매핑 제거(중요). Nginx만 외부로 노출.
    depends_on:
      - backend

  nginx:
    image: nginx:1.27-alpine
    container_name: coretech-nginx
    depends_on:
      - frontend
      - backend
    ports:
      - "80:80"
      - "3000:3000"  # https://도메인:3000 받는 포트
    volumes:
      - ./infra/nginx/conf.d:/etc/nginx/conf.d
      - ./infra/nginx/snippets:/etc/nginx/snippets
      - certbot-etc:/etc/letsencrypt
      - certbot-webroot:/var/www/certbot
    restart: unless-stopped

  certbot:
    image: certbot/certbot:latest
    container_name: coretech-certbot
    volumes:
      - certbot-etc:/etc/letsencrypt
      - certbot-webroot:/var/www/certbot
        #    entrypoint: sh
    # 매일 2회 갱신 시도
    #    command: -c "while :; do certbot renew --webroot -w /var/www/certbot && echo 'renew ok'; sleep 12h; done"
    restart: unless-stopped

volumes:
  pgdata:
  certbot-etc:
  certbot-webroot:

