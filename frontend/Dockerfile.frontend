# Frontend (Next.js)
FROM node:20-bullseye-slim AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:20-bullseye-slim AS build
WORKDIR /app
ENV NODE_ENV=production
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/. .
RUN find . -type f -name "*.tsx" -exec sh -c "iconv -f UTF-8 -t UTF-8 -o {} {}.tmp && mv {}.tmp {}" \; 
RUN find . -type f -name "*.ts" -exec sh -c "iconv -f UTF-8 -t UTF-8 -o {}.tmp && mv {}.tmp {}" \; 
RUN find . -type f -name "*.js" -exec sh -c "iconv -f UTF-8 -t UTF-8 -o {}.tmp && mv {}.tmp {}" \; 
RUN find . -type f -name "*.json" -exec sh -c "iconv -f UTF-8 -t UTF-8 -o {}.tmp && mv {}.tmp {}" \; 
RUN find . -type f -name "*.md" -exec sh -c "iconv -f UTF-8 -t UTF-8 -o {}.tmp && mv {}.tmp {}" \; 
# Ensure optional dirs exist so COPY in runner doesn't fail
RUN mkdir -p lib content
RUN npm run build

FROM node:20-bullseye-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# Next.js runtime
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# Next.js requires production deps and the .next build output
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.mjs ./next.config.mjs
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/app ./app
COPY --from=build /app/components ./components
COPY --from=build /app/lib ./lib
COPY --from=build /app/content ./content
EXPOSE 3000
CMD ["npm", "start"]
