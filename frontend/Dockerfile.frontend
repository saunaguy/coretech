# Frontend (Next.js)
FROM node:20-bullseye-slim AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:20-bullseye-slim AS build
WORKDIR /app
ENV NODE_ENV=production
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ARG INACTIVITY_EXPIRE_SECONDS
ENV INACTIVITY_EXPIRE_SECONDS=${INACTIVITY_EXPIRE_SECONDS}
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/. .
## Remove fragile iconv normalization steps which can fail on slim images
## and are unnecessary for Node builds.
# Ensure optional dirs exist so COPY in runner doesn't fail (kept for safety)
RUN mkdir -p lib content
RUN npm run build

FROM node:20-bullseye-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# Next.js runtime
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# Next.js requires production deps and the .next build output
## Copy the entire built app to avoid COPY "cannot stat" when
## a subdirectory is missing in some branches/configs.
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "start"]
