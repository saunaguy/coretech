POSTGRES_DB=coretech
POSTGRES_USER=coretech
POSTGRES_PASSWORD=coretech

# Backend FastAPI -> Postgres (service name `db` in docker-compose)
DATABASE_URL=postgresql+psycopg://coretech:coretech@db:5432/coretech

# JWT/Backend defaults (development only)
SECRET_KEY=change-this-in-development
JWT_EXPIRE_MINUTES=1440

# Frontend build-time API base used by Dockerfile.frontend
API_BASE_URL=http://localhost:8000
