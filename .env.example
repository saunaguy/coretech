EXA_API_KEY=your_exa_api_key_here

# Frontend/Backend shared base URL for API
# Example: API_BASE_URL=http://192.168.0.10:8000
API_BASE_URL=http://localhost:8000

# (Optional) If using the backend CORS guard, set allowed origins
# Example: CORS_ORIGINS=http://192.168.0.10:3000
#CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
