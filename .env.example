# Public/safe examples only
LOG_LEVEL=info
API_BASE_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security / Backend
SECRET_KEY=change-this-in-production
JWT_EXPIRE_MINUTES=1440

# Database
# e.g. sqlite:///./coretech.db  or  postgresql+psycopg://user:pass@localhost:5432/coretech
DATABASE_URL=sqlite:///./coretech.db

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres (docker-compose)
POSTGRES_DB=coretech
POSTGRES_USER=coretech
POSTGRES_PASSWORD=coretech

# Frontend → Backend (client-side fetch base)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://localhost:8000

